# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local
logs/*.jsonl
eval/results.json
!.env.example

# perfis temporários de verificação visual
.taste-skill/

# grafo gerado pelo /graphify (regenere com: graphify update .)
graphify-out/

# impeccable: só o brief da tela, o design.json e a configuração vão para o Git; o resto é rascunho de trabalho
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/build/
/.impeccable/hook.cache.json
/.impeccable/config.local.json
