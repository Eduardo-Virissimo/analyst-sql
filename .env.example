# Copie para .env.local e preencha. O .env.local nunca vai para o Git.

# ───────────── IA ─────────────
# Escolha UM dos dois blocos.

# (A) Gemini (tem plano gratuito) — chave em https://aistudio.google.com
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Confira o nome atual do modelo no AI Studio: modelos antigos saem do ar para contas novas
# (gemini-2.5-flash e gemini-2.5-flash-lite já retornam 404). Teste com: npm run check:llm
LLM_MODEL=gemini-3.5-flash-lite

# (B) Claude (Anthropic) — chave em https://console.anthropic.com
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# ───────────── Banco ─────────────
# O compose.yaml publica o MySQL em 127.0.0.1:3307 (só a sua máquina enxerga).
DB_HOST=localhost
DB_PORT=3307
DB_USER=agent_readonly
# Precisa ser igual à senha criada em db/setup.sql (CREATE USER ... IDENTIFIED BY).
# Troque as duas antes de publicar qualquer coisa.
DB_PASSWORD=change_this_password
DB_NAME=hr_agent
